{
  "name": "@paperagent/agent-engine-reactplan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "eval:react": "node eval/run.mjs",
    "eval:compare": "node eval/compare.mjs",
    "eval:react:control": "node eval/control.mjs",
    "eval:react:browser": "node eval/browser.mjs",
    "test:eval": "node --test eval/*.test.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "playwright-core": "1.55.0",
    "typescript": "5.7.2",
    "vitest": "4.1.10"
  }
}
