{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperagent.local/agent-engine/schemas/model-gateway.schema.json",
  "title": "ProductModelGatewayTypes",
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "toolCall": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "arguments"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "arguments": { "type": "string", "maxLength": 65536 }
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "clientRequestId", "requestDigest", "provider", "model", "messages", "tools", "maxOutputTokens"],
      "properties": {
        "contractVersion": { "const": "1.0" },
        "clientRequestId": { "type": "string", "pattern": "^model\\.[a-f0-9]{64}$" },
        "requestDigest": { "$ref": "#/$defs/sha256" },
        "provider": { "type": "string", "minLength": 1, "maxLength": 120 },
        "model": { "type": "string", "minLength": 1, "maxLength": 240 },
        "messages": {
          "type": "array", "minItems": 1, "maxItems": 120,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["role", "content"],
            "properties": {
              "role": { "enum": ["system", "user", "assistant", "tool"] },
              "content": { "type": ["string", "null"], "maxLength": 200000 },
              "toolCallId": { "type": "string", "minLength": 1, "maxLength": 256 },
              "toolCalls": { "type": "array", "maxItems": 80, "items": { "$ref": "#/$defs/toolCall" } }
            }
          }
        },
        "tools": {
          "type": "array", "maxItems": 80,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["type", "function"],
            "properties": {
              "type": { "const": "function" },
              "function": {
                "type": "object", "additionalProperties": false,
                "required": ["name", "description", "parameters"],
                "properties": {
                  "name": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "description": { "type": "string", "maxLength": 4000 },
                  "parameters": { "type": "object" }
                }
              }
            }
          }
        },
        "maxOutputTokens": { "type": "integer", "minimum": 1, "maximum": 4096 }
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "clientRequestId", "requestDigest", "content", "toolCalls", "finishReason", "usage", "replayed", "resolvedProvider", "resolvedModel", "fallbackUsed"],
      "properties": {
        "contractVersion": { "const": "1.0" },
        "clientRequestId": { "type": "string", "pattern": "^model\\.[a-f0-9]{64}$" },
        "requestDigest": { "$ref": "#/$defs/sha256" },
        "content": { "type": ["string", "null"], "maxLength": 200000 },
        "toolCalls": { "type": "array", "maxItems": 80, "items": { "$ref": "#/$defs/toolCall" } },
        "finishReason": { "type": ["string", "null"], "maxLength": 120 },
        "usage": {
          "type": "object", "additionalProperties": false,
          "required": ["promptTokens", "completionTokens"],
          "properties": {
            "promptTokens": { "type": "integer", "minimum": 0 },
            "completionTokens": { "type": "integer", "minimum": 0 }
          }
        },
        "replayed": { "type": "boolean" },
        "resolvedProvider": { "type": "string", "minLength": 1, "maxLength": 120 },
        "resolvedModel": { "type": "string", "minLength": 1, "maxLength": 240 },
        "fallbackUsed": { "type": "boolean" }
      }
    }
  }
}
