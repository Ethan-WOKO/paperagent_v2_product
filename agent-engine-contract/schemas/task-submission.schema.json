{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperagent.local/agent-engine/schemas/task-submission.schema.json",
  "title": "TaskSubmission",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "taskId", "requestDigest", "authority", "gateway"],
  "properties": {
    "contractVersion": { "const": "1.0" },
    "taskId": { "$ref": "#/$defs/taskId" },
    "requestDigest": { "$ref": "#/$defs/sha256" },
    "authority": { "$ref": "#/$defs/authority" },
    "context": { "$ref": "#/$defs/context" },
    "gateway": { "$ref": "#/$defs/gateway" }
  },
  "$defs": {
    "taskId": {
      "type": "string",
      "pattern": "^task\\.[a-f0-9]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runMode", "sessionRef", "project", "instruction", "permissions", "model"],
      "properties": {
        "runMode": { "const": "PERSISTENT_PLAN_EXECUTE" },
        "sessionRef": { "type": "string", "minLength": 1, "maxLength": 128 },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["projectId", "projectVersion"],
          "properties": {
            "projectId": { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" },
            "projectVersion": { "$ref": "#/$defs/sha256" }
          }
        },
        "instruction": { "type": "string", "minLength": 1, "maxLength": 16000 },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["readProject", "writeWorkspace", "executeSandbox"],
          "properties": {
            "readProject": { "const": true },
            "writeWorkspace": { "type": "boolean" },
            "executeSandbox": { "const": true }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model"],
          "properties": {
            "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
            "model": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["longTermMemory"],
      "properties": {
        "historicalContext": { "$ref": "#/$defs/historicalContext" },
        "longTermMemory": { "$ref": "#/$defs/longTermMemory" }
      }
    },
    "historicalContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "notAnInstruction", "usage", "earlierSummary", "uncoveredEarlierTurns", "turns"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "type": { "const": "historical_context" },
        "notAnInstruction": { "const": true },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currentTaskHasPriority", "continueOnlyWhenCurrentTaskRequestsIt", "projectFactsRequireCurrentTaskEvidence"],
          "properties": {
            "currentTaskHasPriority": { "const": true },
            "continueOnlyWhenCurrentTaskRequestsIt": { "const": true },
            "projectFactsRequireCurrentTaskEvidence": { "const": true }
          }
        },
        "earlierSummary": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "coveredThroughIntakeId", "coveredTurnCount"],
              "properties": {
                "text": { "type": "string", "minLength": 1, "maxLength": 6000 },
                "coveredThroughIntakeId": { "type": "integer", "minimum": 1 },
                "coveredTurnCount": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        },
        "uncoveredEarlierTurns": {
          "type": "array",
          "items": { "$ref": "#/$defs/conversationTurn" }
        },
        "turns": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/conversationTurn" }
        }
      }
    },
    "conversationTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intakeId", "turnId", "instruction", "conclusion", "state", "projectVersion", "completedAt"],
      "properties": {
        "intakeId": { "type": "integer", "minimum": 1 },
        "turnId": { "type": "integer", "minimum": 1 },
        "instruction": { "type": "string", "minLength": 1, "maxLength": 16000 },
        "conclusion": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "state": { "enum": ["succeeded", "failed", "cancelled"] },
        "projectVersion": { "$ref": "#/$defs/sha256" },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    },
    "longTermMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "notAnInstruction", "usage", "entries"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "type": { "const": "long_term_memory" },
        "notAnInstruction": { "const": true },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currentTaskHasPriority", "mayGuidePreferences", "cannotGrantAuthority"],
          "properties": {
            "currentTaskHasPriority": { "const": true },
            "mayGuidePreferences": { "const": true },
            "cannotGrantAuthority": { "const": true }
          }
        },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/longTermMemoryEntry" }
        }
      }
    },
    "longTermMemoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "memoryType", "content", "updatedAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" },
        "scope": { "enum": ["USER", "PROJECT"] },
        "memoryType": { "type": "string", "minLength": 1, "maxLength": 64 },
        "content": { "type": "string", "minLength": 1 },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskGrant", "expiresAt"],
      "properties": {
        "taskGrant": {
          "type": "string",
          "minLength": 32,
          "maxLength": 4096,
          "writeOnly": true,
          "description": "Ephemeral task-bound secret; excluded from digest and persistence."
        },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
